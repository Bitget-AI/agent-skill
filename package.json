{
  "name": "@bitget-ai/bitget-agent-skill",
  "version": "3.0.0",
  "packageManager": "pnpm@8.14.1",
  "description": "Official Bitget AI skill — teaches Claude Code, Codex, and OpenClaw when and how to drive the Bitget Unified Trading Account (UTA / v3) API through the `bgc` CLI from natural language. Run `npx @bitget-ai/bitget-agent-skill` to deploy into your AI tool's skill directory.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "bitget-agent-skill": "scripts/install.js"
  },
  "files": [
    "skills",
    "references",
    "scripts",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "VERSION"
  ],
  "scripts": {
    "gen-references": "node scripts/gen-references.js",
    "install-skill": "node scripts/install.js",
    "e2e:real": "node e2e/run.mjs",
    "e2e:agent": "node e2e/agent/run.mjs",
    "prepublishOnly": "node scripts/gen-references.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "bitget",
    "bitget-skill",
    "skill",
    "claude-code",
    "codex",
    "openclaw",
    "trading",
    "crypto",
    "ai-agent",
    "natural-language"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@bitget-ai/bitget-agent-sdk": "^3.0.0"
  }
}
